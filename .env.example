# =====================================================================
# ChessOx environment configuration — copy to `.env` and fill in.
# Never commit the real `.env` (it is gitignored).
# =====================================================================

# ---- Public (shipped to the browser; safe to expose) ----
# Vite replaces import.meta.env.VITE_* at build time.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# ---- Server-only (NEVER expose to the client) ----
# Read at request time via process.env inside server handlers.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# REQUIRED for server-authoritative moves (src/lib/api/game.functions.ts).
# This key bypasses RLS — keep it secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- YouTube Data API v3 (server-side only — never exposed to browser) ----
# Powers the YouTubeTopicVideo component on the How To Use page.
# Get your key at: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
# Enable "YouTube Data API v3", create an API key, restrict it to server IPs.
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"

# ---- Email OTP registration verification (server-side only) ----
# Sends the 6-digit signup verification code via Resend (https://resend.com).
# Get your key at: https://resend.com/api-keys — the "from" address's domain
# must be a verified domain in your Resend account (or use the shared
# onboarding@resend.dev sender for testing).
# If unset, requests fall back to logging the OTP to the server console
# instead of emailing it — that fallback ONLY runs when NODE_ENV is not
# "production", so production deployments must set this.
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="ChessOx <onboarding@resend.dev>"

# Secret pepper used to HMAC-hash OTPs before storing them (never store OTPs
# in plaintext). Generate with: openssl rand -hex 32
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset — set a dedicated value
# in production so rotating one secret doesn't invalidate the other.
OTP_HASH_SECRET="your-random-hex-secret"
